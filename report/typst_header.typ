// Included by `make report` in the PDF build (pandoc --include-in-header): tables read left to right, unjustified, a size smaller than the body.
#show table: set align(left)
#show table: set par(justify: false)
#show table: set text(size: 0.9em)
#show figure: set block(breakable: true)  // a long table may continue on the next page instead of leaving a blank one
